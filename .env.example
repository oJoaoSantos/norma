DATABASE_URL=postgres://norma:norma@localhost:5432/norma

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Alternativa a Ollama: Groq (API gratuita, serve modelos open-weight tipo
# Llama). Útil se a tua máquina não tiver RAM/CPU para correr o modelo
# localmente. Para usar: LLM_PROVIDER=groq, preenche GROQ_API_KEY (criar em
# https://console.groq.com/keys) e opcionalmente GROQ_MODEL.
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# gerar com: openssl rand -base64 33
AUTH_SECRET=

# usados só uma vez pelo script `npm run db:seed-admin`
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=

ENTIDADE_DEMO_NOME=Entidade Demo

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
