# Copia para ".env" na VM antes de correr `docker compose up -d --build`.
# Ao contrário do .env.example (dev local), o hostname aqui é o nome do
# serviço do docker-compose.yml ("db"), não localhost — o DATABASE_URL
# abaixo é só documentação, o docker-compose.yml já o força nos serviços
# "app"/"migrate".
DATABASE_URL=postgres://norma:norma@db:5432/norma

# Groq em vez de Ollama: a VM grátis (Google Cloud e2-micro, 1GB RAM) não
# tem RAM para correr um LLM local. A Groq serve o mesmo tipo de modelo
# open-weight (Llama) por API gratuita. Cria a tua chave em
# https://console.groq.com/keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# gerar com: openssl rand -base64 33
AUTH_SECRET=

# Domínio público. Com DNS a apontar para o IP desta VM, põe aqui o domínio
# (ex. norma.exemplo.pt) e a Caddy ativa HTTPS automático. Sem domínio,
# deixa o valor ":80" tal como está — fica em HTTP simples pelo IP da VM.
DOMAIN=:80

# usados só uma vez pelo script `npm run db:seed-admin` (idempotente — corre
# sempre no deploy, mas só cria as contas se ainda não existirem)
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=

ENTIDADE_DEMO_NOME=Entidade Demo

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
